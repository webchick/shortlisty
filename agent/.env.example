# Agent environment. Copy to .env, fill in real values.

ANTHROPIC_API_KEY=sk-ant-...

SUPABASE_URL=https://YOUR-PROJECT.supabase.co  # same value as NEXT_PUBLIC_SUPABASE_URL in web/.env.local
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=you@yourdomain.com
DIGEST_FROM_NAME="Job Agent"

AGENT_VERSION=v1
LOG_LEVEL=INFO
